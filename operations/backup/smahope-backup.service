[Unit]
Description=SMA Hope encrypted MySQL backup
After=mysql.service
[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/local/sbin/smahope-backup
TimeoutStartSec=1800
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/smahope /run/lock
